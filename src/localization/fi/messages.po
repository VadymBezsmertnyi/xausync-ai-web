#. js-lingui-explicit-id
msgid "About {NAME_APP}"
msgstr "Tietoja {NAME_APP}sta"

#. js-lingui-explicit-id
msgid "Your professional beauty companion"
msgstr "Ammattimainen kauneuskumppanisi"

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP} – your comprehensive mobile solution for beauty professionals! Our app is designed to streamline your business operations, manage client relationships, and boost your productivity."
msgstr "Tervetuloa {NAME_APP} – kauneusalan ammattilaisten kattava mobiiliratkaisu! Sovelluksemme on suunniteltu virtaviivaistamaan liiketoimintaasi, hallitsemaan asiakassuhteita ja tehostamaan tuottavuuttasi."

#. js-lingui-explicit-id
msgid "Key Features"
msgstr "Keskeiset ominaisuudet"

#. js-lingui-explicit-id
msgid "Client Management"
msgstr "Asiakashallinta"

#. js-lingui-explicit-id
msgid "Create detailed client profiles, track service history, and maintain comprehensive notes for each appointment."
msgstr "Luo yksityiskohtaiset asiakasprofiilit, seuraa palveluhistoriaa ja ylläpidä kattavia muistiinpanoja jokaisesta tapaamisesta."

#. js-lingui-explicit-id
msgid "Smart Calendar"
msgstr "Älykäs kalenteri"

#. js-lingui-explicit-id
msgid "Seamless integration with your device calendar. Automatic sync ensures you never miss an appointment."
msgstr "Saumaton integraatio laitteesi kalenteriin. Automaattinen synkronointi varmistaa, ettet koskaan unohda tapaamista."

#. js-lingui-explicit-id
msgid "SMS Notifications"
msgstr "SMS-ilmoitukset"

#. js-lingui-explicit-id
msgid "Send automated SMS reminders to your clients about upcoming appointments and important updates."
msgstr "Lähetä automaattisia SMS-muistutuksia asiakkaillesi tulevista tapaamisista ja tärkeistä päivityksistä."

#. js-lingui-explicit-id
msgid "Speech-to-Text"
msgstr "Puheesta tekstiksi"

#. js-lingui-explicit-id
msgid "Convert your voice notes into text for quick and easy appointment documentation and client notes."
msgstr "Muunna äänimuistiinpanosi tekstiksi nopeaa ja helppoa tapaamisten dokumentointia ja asiakasmuistiinpanoja varten."

#. js-lingui-explicit-id
msgid "Photo Gallery"
msgstr "Kuvagalleria"

#. js-lingui-explicit-id
msgid "Store and organize photos from each appointment to track client progress and showcase your work."
msgstr "Tallenna ja järjestä kuvat jokaisesta tapaamisesta asiakkaan edistyksen seuraamiseksi ja työn esittelemiseksi."

#. js-lingui-explicit-id
msgid "Multi-Platform Sync"
msgstr "Monialustajen synkronointi"

#. js-lingui-explicit-id
msgid "Access your data seamlessly across mobile app and web platform with real-time synchronization."
msgstr "Pääse tietoihisi saumattomasti mobiilisovelluksen ja verkkopalvelun välillä reaaliaikaisella synkronoinnilla."

#. js-lingui-explicit-id
msgid "Subscription Plans"
msgstr "Tilaussuunnitelmat"

#. js-lingui-explicit-id
msgid "Free"
msgstr "Ilmainen"

#. js-lingui-explicit-id
msgid "$0/month"
msgstr "0$/kk"

