#. js-lingui-explicit-id
msgid "About {NAME_APP}"
msgstr "Om {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your professional beauty companion"
msgstr "Din professionella skönhetpartner"

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP} – your comprehensive mobile solution for beauty professionals! Our app is designed to streamline your business operations, manage client relationships, and boost your productivity."
msgstr "Välkommen till {NAME_APP} – din heltäckande mobila lösning för skönhetsprofessionella! Vår app är utformad för att effektivisera dina företagsverksamheter, hantera kundrelationer och öka din produktivitet."

#. js-lingui-explicit-id
msgid "Key Features"
msgstr "Huvudfunktioner"

#. js-lingui-explicit-id
msgid "Client Management"
msgstr "Kundhantering"

#. js-lingui-explicit-id
msgid "Create detailed client profiles, track service history, and maintain comprehensive notes for each appointment."
msgstr "Skapa detaljerade kundprofiler, spåra servicehistorik och underhåll omfattande anteckningar för varje bokning."

#. js-lingui-explicit-id
msgid "Smart Calendar"
msgstr "Smart kalender"

#. js-lingui-explicit-id
msgid "Seamless integration with your device calendar. Automatic sync ensures you never miss an appointment."
msgstr "Sömlös integration med din enhets kalender. Automatisk synkronisering säkerställer att du aldrig missar en bokning."

#. js-lingui-explicit-id
msgid "SMS Notifications"
msgstr "SMS-notifieringar"

#. js-lingui-explicit-id
msgid "Send automated SMS reminders to your clients about upcoming appointments and important updates."
msgstr "Skicka automatiska SMS-påminnelser till dina kunder om kommande bokningar och viktiga uppdateringar."

#. js-lingui-explicit-id
msgid "Speech-to-Text"
msgstr "Tal-till-text"

#. js-lingui-explicit-id
msgid "Convert your voice notes into text for quick and easy appointment documentation and client notes."
msgstr "Konvertera dina röstanteckningar till text för snabb och enkel bokningsdokumentation och kundanteckningar."

#. js-lingui-explicit-id
msgid "Photo Gallery"
msgstr "Fotogalleri"

#. js-lingui-explicit-id
msgid "Store and organize photos from each appointment to track client progress and showcase your work."
msgstr "Lagra och organisera bilder från varje bokning för att spåra kundens framsteg och visa upp ditt arbete."

#. js-lingui-explicit-id
msgid "Multi-Platform Sync"
msgstr "Multiplattformssynkronisering"

#. js-lingui-explicit-id
msgid "Access your data seamlessly across mobile app and web platform with real-time synchronization."
msgstr "Få tillgång till dina data sömlöst över mobilapp och webbplattform med realtidssynkronisering."

