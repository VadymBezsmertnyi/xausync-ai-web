msgstr "{NAME_APP} – Smart Planlægningsapp for Skønhedseksperter"

#. js-lingui-explicit-id
msgid "Beauty Sync helps beauty professionals manage appointments, clients, and reminders with ease."
msgstr "Beauty Sync hjælper skønhedsprofessionelle med at håndtere aftaler, kunder og påmindelser med lethed."

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP}"
msgstr "Velkommen til {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your Professional Beauty Companion"
msgstr "Din Professionelle Skønhedspartner"

#. js-lingui-explicit-id
msgid "Streamline your beauty business with our comprehensive mobile solution. Manage appointments, track clients, and boost productivity with ease."
msgstr "Strømlin din skønhedsvirksomhed med vores omfattende mobile løsning. Håndter aftaler, spor kunder og øg produktivitet med lethed."

