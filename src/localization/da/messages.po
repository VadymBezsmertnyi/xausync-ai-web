#. js-lingui-explicit-id
msgid "About {NAME_APP}"
msgstr "Om {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your professional beauty companion"
msgstr "Din professionelle skønhedspartner"

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP} – your comprehensive mobile solution for beauty professionals! Our app is designed to streamline your business operations, manage client relationships, and boost your productivity."
msgstr "Velkommen til {NAME_APP} – din omfattende mobile løsning for skønhedsprofessionelle! Vores app er designet til at effektivisere dine forretningdrift, administrere kunderelationer og øge din produktivitet."

#. js-lingui-explicit-id
msgid "Key Features"
msgstr "Nøglefunktioner"

#. js-lingui-explicit-id
msgid "Client Management"
msgstr "Kundehåndtering"

#. js-lingui-explicit-id
msgid "Create detailed client profiles, track service history, and maintain comprehensive notes for each appointment."
msgstr "Opret detaljerede kundeprofiler, spor servicehistorik og vedligeholde omfattende noter for hver aftale."

#. js-lingui-explicit-id
msgid "Smart Calendar"
msgstr "Smart Kalender"

#. js-lingui-explicit-id
msgid "Seamless integration with your device calendar. Automatic sync ensures you never miss an appointment."
msgstr "Problemfri integration med din enhedskalender. Automatisk synkronisering sikrer, at du aldrig går glip af en aftale."

#. js-lingui-explicit-id
msgid "SMS Notifications"
msgstr "SMS-beskeder"

#. js-lingui-explicit-id
msgid "Send automated SMS reminders to your clients about upcoming appointments and important updates."
msgstr "Send automatiske SMS-påmindelser til dine kunder om kommende aftaler og vigtige opdateringer."

#. js-lingui-explicit-id
msgid "Speech-to-Text"
msgstr "Tale-til-tekst"

#. js-lingui-explicit-id
msgid "Convert your voice notes into text for quick and easy appointment documentation and client notes."
msgstr "Konverter dine stemmenoter til tekst for hurtig og nem aftaledokumentation og kundenoter."

#. js-lingui-explicit-id
msgid "Photo Gallery"
msgstr "Fotogalleri"

#. js-lingui-explicit-id
msgid "Store and organize photos from each appointment to track client progress and showcase your work."
msgstr "Opbevar og organiser fotos fra hver aftale for at spore kundefremskridt og fremvise dit arbejde."

#. js-lingui-explicit-id
msgid "Multi-Platform Sync"
msgstr "Multi-platform synkronisering"

#. js-lingui-explicit-id
msgid "Access your data seamlessly across mobile app and web platform with real-time synchronization."
msgstr "Få adgang til dine data problemfrit på tværs af mobilapp og webplatform med realtidssynkronisering."

