msgstr "Безплатен план"

#. js-lingui-explicit-id
msgid "Price: Free"
msgstr "Цена: Безплатно"

#. js-lingui-explicit-id
msgid "Basic calendar sync"
msgstr "Базово синхронизиране на календар"

#. js-lingui-explicit-id
msgid "Pro Plan"
msgstr "Pro план"

#. js-lingui-explicit-id
msgid "Price: $4.99 per month"
msgstr "Цена: $4.99 на месец"

#. js-lingui-explicit-id
msgid "Advanced calendar sync"
msgstr "Разширено синхронизиране на календар"

#. js-lingui-explicit-id
msgid "Premium Plan"
msgstr "Premium план"

