#. js-lingui-explicit-id
msgid "1 photo per appointment"
msgstr "1 снимка на среща"

#. js-lingui-explicit-id
msgid "1 SMS per month"
msgstr "1 SMS на месец"

#. js-lingui-explicit-id
msgid "3 minutes speech-to-text per month"
msgstr "3 минути реч-текст на месец"

#. js-lingui-explicit-id
msgid "Pro"
msgstr "Pro"

#. js-lingui-explicit-id
msgid "$4.99/month"
msgstr "$4.99/месец"

#. js-lingui-explicit-id
msgid "Up to 100 clients"
msgstr "До 100 клиенти"

#. js-lingui-explicit-id
msgid "10 appointments per client"
