#. js-lingui-explicit-id
msgid "The following subscription plans are available:"
msgstr "Prieinami šios prenumeratos planai:"

#. js-lingui-explicit-id
msgid "Free Plan"
msgstr "Nemokamas planas"

#. js-lingui-explicit-id
msgid "Price: Free"
msgstr "Kaina: Nemokamai"

#. js-lingui-explicit-id
msgid "Basic calendar sync"
msgstr "Pagrindinis kalendoriaus sinchronizavimas"

#. js-lingui-explicit-id
