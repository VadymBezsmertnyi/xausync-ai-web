msgid "Uptime"
msgstr "Darbo laikas"

#. js-lingui-explicit-id
msgid "App Rating"
msgstr "Programos įvertinimas"

#. js-lingui-explicit-id
msgid "{NAME_APP} – Smart Scheduling App for Beauty Experts"
msgstr "{NAME_APP} – Išmanus tvarkaraščio programėlė grožio profesionalams"

#. js-lingui-explicit-id
msgid "Beauty Sync helps beauty professionals manage appointments, clients, and reminders with ease."
msgstr "Beauty Sync padeda grožio profesionalams lengvai tvarkyti vizitus, klientus ir priminimus."

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP}"
msgstr "Sveiki atvykę į {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your Professional Beauty Companion"
msgstr "Jūsų profesionalus grožio partneris"

#. js-lingui-explicit-id
msgid "Streamline your beauty business with our comprehensive mobile solution. Manage appointments, track clients, and boost productivity with ease."
msgstr "Supaprastinkite savo grožio verslą su mūsų išsamia mobiliaja sprendimu. Lengvai tvarkykite vizitus, stebkite klientus ir didinkite produktyvumą."

#. js-lingui-explicit-id
msgid "Download on App Store"
msgstr "Atsisiųsti iš App Store"

#. js-lingui-explicit-id
msgid "Get it on Google Play"
msgstr "Gaukite ją Google Play"

#. js-lingui-explicit-id
msgid "4.8★ Rating"
msgstr "4.8★ Įvertinimas"

#. js-lingui-explicit-id
msgid "Secure & Private"
msgstr "Saugus ir privatus"

#. js-lingui-explicit-id
msgid "Fast & Reliable"
msgstr "Greitas ir patikimas"

#. js-lingui-explicit-id
msgid "Everything you need to manage your beauty business efficiently"
msgstr "Viskas, ko jums reikia efektyviai tvarkyti savo grožio verslą"

#. js-lingui-explicit-id
msgid "Ready to Transform Your Business?"
msgstr "Pasiruošę keisti savo verslą?"

#. js-lingui-explicit-id
msgid "Join thousands of beauty professionals who trust {NAME_APP} to manage their business"
msgstr "Prisijunkite prie tūkstančių grožio profesionalų, kurie pasitiki {NAME_APP} savo verslo valdymui"

#. js-lingui-explicit-id
msgid "Last updated:"
msgstr "Paskutinis atnaujinimas:"

#. js-lingui-explicit-id
