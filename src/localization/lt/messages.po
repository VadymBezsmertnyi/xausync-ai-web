msgstr "Pro planas"

#. js-lingui-explicit-id
msgid "Price: $4.99 per month"
msgstr "Kaina: $4.99 per mėnesį"

#. js-lingui-explicit-id
msgid "Advanced calendar sync"
msgstr "Išplėstinis kalendoriaus sinchronizavimas"

#. js-lingui-explicit-id
