#. js-lingui-explicit-id
msgid "About {NAME_APP}"
msgstr "O aplikácii {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your professional beauty companion"
msgstr "Váš profesionálny krásny spoločník"

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP} – your comprehensive mobile solution for beauty professionals! Our app is designed to streamline your business operations, manage client relationships, and boost your productivity."
msgstr "Vitajte v {NAME_APP} – vaše komplexné mobilné riešenie pre profesionálov v oblasti krásy! Naša aplikácia je navrhnutá tak, aby zefektívnila vaše obchodné operácie, spravovala vzťahy s klientmi a zvýšila vašu produktivitu."

#. js-lingui-explicit-id
msgid "Key Features"
msgstr "Kľúčové funkcie"

#. js-lingui-explicit-id
msgid "Client Management"
msgstr "Správa klientov"

#. js-lingui-explicit-id
msgid "Create detailed client profiles, track service history, and maintain comprehensive notes for each appointment."
msgstr "Vytvárajte detailné profily klientov, sledujte históriu služieb a udržujte komplexné poznámky pre každú schôdzku."

#. js-lingui-explicit-id
msgid "Smart Calendar"
msgstr "Inteligentný kalendár"

#. js-lingui-explicit-id
msgid "Seamless integration with your device calendar. Automatic sync ensures you never miss an appointment."
msgstr "Bezproblémová integrácia s kalendárom vášho zariadenia. Automatická synchronizácia zabezpečuje, že nikdy nezmeškáte schôdzku."

#. js-lingui-explicit-id
msgid "SMS Notifications"
msgstr "SMS notifikácie"

#. js-lingui-explicit-id
msgid "Send automated SMS reminders to your clients about upcoming appointments and important updates."
msgstr "Posielajte automatizované SMS pripomienky svojim klientom o nadchádzajúcich schôdzkach a dôležitých aktualizáciách."

#. js-lingui-explicit-id
msgid "Speech-to-Text"
msgstr "Reč na text"

#. js-lingui-explicit-id
msgid "Convert your voice notes into text for quick and easy appointment documentation and client notes."
msgstr "Prevádzajte svoje hlasové poznámky na text pre rýchlu a jednoduchú dokumentáciu schôdzok a poznámok o klientoch."

#. js-lingui-explicit-id
msgid "Photo Gallery"
msgstr "Fotogaléria"

#. js-lingui-explicit-id
msgid "Store and organize photos from each appointment to track client progress and showcase your work."
msgstr "Ukladajte a organizujte fotografie z každej schôdzky na sledovanie postupu klienta a prezentáciu svojej práce."

#. js-lingui-explicit-id
msgid "Multi-Platform Sync"
msgstr "Synchronizácia viacerých platforiem"

#. js-lingui-explicit-id
msgid "Access your data seamlessly across mobile app and web platform with real-time synchronization."
msgstr "Prístupujte k svojim dátam bezproblémovo naprieč mobilnej aplikácie a webovej platformy s reálnou synchronizáciou."

