#. js-lingui-explicit-id
msgid "The \"{NAME_APP}\" mobile and web applications are developed and operated by Vadym Bezsmertnyi, FOP (\"us\", \"we\", or \"our\"). This Privacy Policy explains how we collect, use, and protect your personal information when you access and use our mobile application and services (\"Service\")."
msgstr "Mobilné a webové aplikácie \"{NAME_APP}\" sú vyvíjané a prevádzané Vadymom Bezsmertným, FOP (\"nás\", \"my\" alebo \"naše\"). Toto Zásady ochrany osobných údajov vysvetľuje, ako zhromažďujeme, používame a chránime vaše osobné informácie, keď pristupujete a používate našu mobilnú aplikáciu a služby (\"Služba\")."

#. js-lingui-explicit-id
msgid "Information We Collect"
msgstr "Informácie, Ktoré Zhromažďujeme"

#. js-lingui-explicit-id
msgid "Information Collection"
msgstr "Zhromažďovanie Informácií"

#. js-lingui-explicit-id
msgid "We collect information to ensure the effective functionality of the {NAME_APP} app. The data collected may include:"
msgstr "Zhromažďujeme informácie, aby sme zaistili efektívnu funkčnosť aplikácie {NAME_APP}. Zhromaždené údaje môžu zahŕňať:"

#. js-lingui-explicit-id
msgid "Contacts: to create client records."
msgstr "Kontakty: na vytváranie záznamov klientov."

#. js-lingui-explicit-id
msgid "Calendar data: to synchronize appointments and reminders."
msgstr "Údaje kalendára: na synchronizáciu schôdzok a pripomienok."

#. js-lingui-explicit-id
msgid "Camera and photo library: to upload client or work photos."
msgstr "Kamera a fotogaléria: na nahrávanie fotografií klientov alebo z práce."

#. js-lingui-explicit-id
msgid "Push notifications: to remind users about upcoming appointments."
msgstr "Push notifikácie: na pripomínanie používateľov o nadchádzajúcich schôdzkach."

#. js-lingui-explicit-id
msgid "Personal user information: such as name, email address, and phone number."
msgstr "Osobné informácie používateľa: ako meno, emailová adresa a telefónne číslo."

#. js-lingui-explicit-id
msgid "Subscription information: for managing your account and processing payments. Prices may vary by region and are subject to local taxes."
msgstr "Informace o předplatném: pro správu vašeho účtu a zpracování plateb. Ceny se mohou lišit v závislosti na regionu a podléhají místním daním."

#. js-lingui-explicit-id
msgid "Voice recordings: for speech-to-text functionality to convert voice notes into text for appointment documentation."
msgstr "Záznamy hlasu: pro funkci převodu řeči na text, která převádí hlasové poznámky na text pro dokumentaci schůzek."

#. js-lingui-explicit-id
msgid "SMS data: for sending automated reminders to clients about upcoming appointments."
msgstr "SMS data: pro odesílání automatických připomínek klientům o nadcházejících schůzkách."

#. js-lingui-explicit-id
msgid "Usage analytics: to improve app functionality and user experience."
msgstr "Analytika používania: na zlepšenie funkčnosti aplikácie a používateľského zážitku."

#. js-lingui-explicit-id
msgid "Export/import data: for CSV export and import functionality (available with Pro and Premium subscriptions)."
msgstr "Export/import údajov: pre funkčnosť exportu a importu CSV (dostupné s predplatnými Pro a Premium)."

#. js-lingui-explicit-id
msgid "Use of Information"
msgstr "Použitie Informácií"

#. js-lingui-explicit-id
msgid "We process your data based on legitimate interests and contractual necessity. The collected data is used to:"
msgstr "Spracovávame vaše údaje na základe legitimných záujmov a zmluvnej nutnosti. Zhromaždené údaje sa používajú na:"

#. js-lingui-explicit-id
msgid "Create client records and appointments."
msgstr "Vytvoriť záznamy klientov a stretnutia."

#. js-lingui-explicit-id
msgid "Send SMS reminders to clients."
msgstr "Posílejte SMS připomínky klientům."

#. js-lingui-explicit-id
msgid "Convert voice recordings to text for appointment documentation."
msgstr "Convertujte hlasové záznamy na text pro dokumentaci schůzek."

#. js-lingui-explicit-id
msgid "Synchronize the calendar for appointment reminders."
msgstr "Synchronizovať kalendár pre pripomienky na stretnutia."

#. js-lingui-explicit-id
msgid "Enable app features such as uploading photos and creating notes."
msgstr "Povoliť funkcie aplikácie, ako je nahrávanie fotografií a vytváranie poznámok."

#. js-lingui-explicit-id
msgid "Manage subscriptions and process billing."
msgstr "Spravovať predplatné a spracovať platby."

#. js-lingui-explicit-id
msgid "Provide analytics and insights to improve service functionality."
msgstr "Poskytovať analytiky a poznatky na zlepšenie funkčnosti služby."

#. js-lingui-explicit-id
msgid "Ensure compliance with subscription limits and features."
msgstr "Zabezpečiť súlad s limitmi a funkciami predplatného."

#. js-lingui-explicit-id
