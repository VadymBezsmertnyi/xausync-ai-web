msgid "The following subscription plans are available:"
msgstr "다음 구독 플랜이 사용 가능합니다:"

#. js-lingui-explicit-id
msgid "Free Plan"
msgstr "무료 플랜"

#. js-lingui-explicit-id
msgid "Price: Free"
msgstr "가격: 무료"

#. js-lingui-explicit-id
msgid "Basic calendar sync"
msgstr "기본 캘린더 동기화"

#. js-lingui-explicit-id
msgid "Pro Plan"
msgstr "프로 플랜"

#. js-lingui-explicit-id
msgid "Price: $4.99 per month"
msgstr "가격: 월 $4.99"

#. js-lingui-explicit-id
msgid "Advanced calendar sync"
msgstr "고급 캘린더 동기화"

#. js-lingui-explicit-id
msgid "Premium Plan"
msgstr "프리미엄 플랜"

#. js-lingui-explicit-id
msgid "Price: $9.99 per month"
msgstr "가격: 월 $9.99"

#. js-lingui-explicit-id
