msgstr "Valutazione App"

#. js-lingui-explicit-id
msgid "{NAME_APP} – Smart Scheduling App for Beauty Experts"
msgstr "{NAME_APP} – App di Pianificazione Intelligente per Esperti della Bellezza"

#. js-lingui-explicit-id
msgid "Beauty Sync helps beauty professionals manage appointments, clients, and reminders with ease."
msgstr "Beauty Sync aiuta i professionisti della bellezza a gestire appuntamenti, clienti e promemoria con facilità."

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP}"
msgstr "Benvenuto in {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your Professional Beauty Companion"
msgstr "Il Tuo Compagno di Bellezza Professionale"

#. js-lingui-explicit-id
msgid "Streamline your beauty business with our comprehensive mobile solution. Manage appointments, track clients, and boost productivity with ease."
msgstr "Ottimizza il tuo business di bellezza con la nostra soluzione mobile completa. Gestisci appuntamenti, traccia clienti e aumenta la produttività con facilità."

#. js-lingui-explicit-id
msgid "Download on App Store"
