msgstr "Ottienilo su Google Play"

#. js-lingui-explicit-id
msgid "4.8★ Rating"
msgstr "Valutazione 4.8★"

#. js-lingui-explicit-id
msgid "Secure & Private"
msgstr "Sicuro e Privato"

#. js-lingui-explicit-id
msgid "Fast & Reliable"
msgstr "Veloce e Affidabile"

#. js-lingui-explicit-id
msgid "Everything you need to manage your beauty business efficiently"
msgstr "Tutto ciò di cui hai bisogno per gestire il tuo business di bellezza in modo efficiente"

#. js-lingui-explicit-id
msgid "Ready to Transform Your Business?"
msgstr "Pronto a Trasformare il Tuo Business?"

#. js-lingui-explicit-id
msgid "Join thousands of beauty professionals who trust {NAME_APP} to manage their business"
msgstr "Unisciti a migliaia di professionisti della bellezza che si fidano di {NAME_APP} per gestire il loro business"

#. js-lingui-explicit-id
msgid "Last updated:"
msgstr "Ultimo aggiornamento:"

#. js-lingui-explicit-id
msgid "February 6, 2026"
