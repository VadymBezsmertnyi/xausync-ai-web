#. js-lingui-explicit-id
msgid "60 minutes speech-to-text per month"
msgstr "60 minuti di voce-a-testo al mese"

#. js-lingui-explicit-id
msgid "Export clients (CSV)"
msgstr "Esporta clienti (CSV)"

#. js-lingui-explicit-id
