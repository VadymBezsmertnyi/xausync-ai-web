#. js-lingui-explicit-id
msgid "About {NAME_APP}"
msgstr "O aplikaci {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your professional beauty companion"
msgstr "Váš profesionální krásný společník"

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP} – your comprehensive mobile solution for beauty professionals! Our app is designed to streamline your business operations, manage client relationships, and boost your productivity."
msgstr "Vítejte v {NAME_APP} – vašem komplexním mobilním řešení pro profesionály v oblasti krásy! Naše aplikace je navržena tak, aby zefektivnila vaše obchodní operace, spravovala vztahy s klienty a zvýšila vaši produktivitu."

#. js-lingui-explicit-id
msgid "Key Features"
msgstr "Klíčové funkce"

#. js-lingui-explicit-id
msgid "Client Management"
msgstr "Správa klientů"

#. js-lingui-explicit-id
msgid "Create detailed client profiles, track service history, and maintain comprehensive notes for each appointment."
msgstr "Vytvářejte detailní profily klientů, sledujte historii služeb a udržujte komplexní poznámky pro každou schůzku."

#. js-lingui-explicit-id
msgid "Smart Calendar"
msgstr "Chytrý kalendář"

#. js-lingui-explicit-id
msgid "Seamless integration with your device calendar. Automatic sync ensures you never miss an appointment."
msgstr "Bezproblémová integrace s kalendářem vašeho zařízení. Automatická synchronizace zajistí, že nikdy nezmeškáte schůzku."

#. js-lingui-explicit-id
msgid "SMS Notifications"
msgstr "SMS notifikace"

#. js-lingui-explicit-id
msgid "Send automated SMS reminders to your clients about upcoming appointments and important updates."
msgstr "Posílejte automatizované SMS připomínky svým klientům o nadcházejících schůzkách a důležitých aktualizacích."

#. js-lingui-explicit-id
msgid "Speech-to-Text"
msgstr "Řeč na text"

#. js-lingui-explicit-id
msgid "Convert your voice notes into text for quick and easy appointment documentation and client notes."
msgstr "Převádějte své hlasové poznámky na text pro rychlou a snadnou dokumentaci schůzek a poznámky o klientech."

#. js-lingui-explicit-id
msgid "Photo Gallery"
msgstr "Fotogalerie"

#. js-lingui-explicit-id
msgid "Store and organize photos from each appointment to track client progress and showcase your work."
msgstr "Ukládejte a organizujte fotografie z každé schůzky pro sledování postupu klienta a prezentaci své práce."

#. js-lingui-explicit-id
msgid "Multi-Platform Sync"
msgstr "Synchronizace více platforem"

#. js-lingui-explicit-id
msgid "Access your data seamlessly across mobile app and web platform with real-time synchronization."
msgstr "Přistupujte ke svým datům bezproblémově napříč mobilní aplikací a webovou platformou s reálnou synchronizací."

