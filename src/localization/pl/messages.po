#. js-lingui-explicit-id
msgid "About {NAME_APP}"
msgstr "O {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your professional beauty companion"
msgstr "Twój profesjonalny towarzysz piękna"

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP} – your comprehensive mobile solution for beauty professionals! Our app is designed to streamline your business operations, manage client relationships, and boost your productivity."
msgstr "Witamy w {NAME_APP} – Twoje kompleksowe rozwiązanie mobilne dla profesjonalistów urody! Nasza aplikacja jest zaprojektowana, aby usprawnić Twoje operacje biznesowe, zarządzać relacjami z klientami i zwiększyć Twoją produktywność."

#. js-lingui-explicit-id
msgid "Key Features"
msgstr "Główne funkcje"

#. js-lingui-explicit-id
msgid "Client Management"
msgstr "Zarządzanie klientami"

#. js-lingui-explicit-id
msgid "Create detailed client profiles, track service history, and maintain comprehensive notes for each appointment."
msgstr "Twórz szczegółowe profile klientów, śledź historię usług i utrzymuj kompleksowe notatki dla każdego spotkania."

#. js-lingui-explicit-id
msgid "Smart Calendar"
msgstr "Inteligentny kalendarz"

#. js-lingui-explicit-id
msgid "Seamless integration with your device calendar. Automatic sync ensures you never miss an appointment."
msgstr "Bezproblemowa integracja z kalendarzem Twojego urządzenia. Automatyczna synchronizacja zapewnia, że nigdy nie przegapisz spotkania."

#. js-lingui-explicit-id
msgid "SMS Notifications"
msgstr "Powiadomienia SMS"

#. js-lingui-explicit-id
msgid "Send automated SMS reminders to your clients about upcoming appointments and important updates."
msgstr "Wysyłaj automatyczne przypomnienia SMS do swoich klientów o nadchodzących spotkaniach i ważnych aktualizacjach."

#. js-lingui-explicit-id
msgid "Speech-to-Text"
msgstr "Mowa-na-tekst"

#. js-lingui-explicit-id
msgid "Convert your voice notes into text for quick and easy appointment documentation and client notes."
msgstr "Konwertuj swoje notatki głosowe na tekst dla szybkiej i łatwej dokumentacji spotkań i notatek klientów."

#. js-lingui-explicit-id
msgid "Photo Gallery"
msgstr "Galeria zdjęć"

#. js-lingui-explicit-id
msgid "Store and organize photos from each appointment to track client progress and showcase your work."
msgstr "Przechowuj i organizuj zdjęcia z każdego spotkania, aby śledzić postępy klientów i prezentować swoją pracę."

#. js-lingui-explicit-id
msgid "Multi-Platform Sync"
msgstr "Synchronizacja wieloplatformowa"

#. js-lingui-explicit-id
msgid "Access your data seamlessly across mobile app and web platform with real-time synchronization."
msgstr "Dostęp do swoich danych bezproblemowo między aplikacją mobilną a platformą internetową z synchronizacją w czasie rzeczywistym."

