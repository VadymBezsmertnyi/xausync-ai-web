msgid "Export/import clients (CSV)"
msgstr "Exporter/importer les clients (CSV)"

#. js-lingui-explicit-id
msgid "Google Calendar integration"
msgstr "Intégration Google Agenda"

#. js-lingui-explicit-id
msgid "Priority support"
msgstr "Support prioritaire"

#. js-lingui-explicit-id
msgid "Start with our free plan to explore {NAME_APP} features. Upgrade anytime to unlock more capacity and advanced functionality."
msgstr "Commencez avec notre plan gratuit pour explorer les fonctionnalités de {NAME_APP}. Mettez à niveau à tout moment pour débloquer plus de capacité et des fonctionnalités avancées."

