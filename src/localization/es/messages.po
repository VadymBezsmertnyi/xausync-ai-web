#. js-lingui-explicit-id
msgid "About {NAME_APP}"
msgstr "Acerca de {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your professional beauty companion"
msgstr "Tu compañero de belleza profesional"

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP} – your comprehensive mobile solution for beauty professionals! Our app is designed to streamline your business operations, manage client relationships, and boost your productivity."
msgstr "¡Bienvenido a {NAME_APP} – tu solución móvil integral para profesionales de la belleza! Nuestra aplicación está diseñada para optimizar tus operaciones comerciales, gestionar relaciones con clientes y aumentar tu productividad."

#. js-lingui-explicit-id
msgid "Key Features"
msgstr "Características Principales"

#. js-lingui-explicit-id
msgid "Client Management"
msgstr "Gestión de Clientes"

#. js-lingui-explicit-id
msgid "Create detailed client profiles, track service history, and maintain comprehensive notes for each appointment."
msgstr "Cree perfiles de clientes detallados, rastree el historial de servicios y mantenga notas completas para cada cita."

#. js-lingui-explicit-id
msgid "Smart Calendar"
msgstr "Calendario Inteligente"

#. js-lingui-explicit-id
msgid "Seamless integration with your device calendar. Automatic sync ensures you never miss an appointment."
msgstr "Integración perfecta con el calendario de su dispositivo. La sincronización automática asegura que nunca pierda una cita."

#. js-lingui-explicit-id
msgid "SMS Notifications"
msgstr "Notificaciones SMS"

#. js-lingui-explicit-id
msgid "Send automated SMS reminders to your clients about upcoming appointments and important updates."
msgstr "Envíe recordatorios SMS automáticos a sus clientes sobre próximas citas y actualizaciones importantes."

#. js-lingui-explicit-id
msgid "Speech-to-Text"
msgstr "Voz a Texto"

#. js-lingui-explicit-id
msgid "Convert your voice notes into text for quick and easy appointment documentation and client notes."
msgstr "Convierta sus notas de voz en texto para documentación rápida y fácil de citas y notas de clientes."

#. js-lingui-explicit-id
msgid "Photo Gallery"
msgstr "Galería de Fotos"

#. js-lingui-explicit-id
msgid "Store and organize photos from each appointment to track client progress and showcase your work."
msgstr "Almacene y organice fotos de cada cita para rastrear el progreso del cliente y mostrar su trabajo."

#. js-lingui-explicit-id
msgid "Multi-Platform Sync"
msgstr "Sincronización Multiplataforma"

#. js-lingui-explicit-id
msgid "Access your data seamlessly across mobile app and web platform with real-time synchronization."
msgstr "Acceda a sus datos sin problemas en la aplicación móvil y plataforma web con sincronización en tiempo real."

