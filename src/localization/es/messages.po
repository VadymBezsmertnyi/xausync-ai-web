msgstr "Póngase en contacto"

#. js-lingui-explicit-id
msgid "We're constantly improving {NAME_APP} based on your feedback. Have suggestions or questions? We'd love to hear from you!"
msgstr "Estamos mejorando constantemente {NAME_APP} basándonos en sus comentarios. ¿Tiene sugerencias o preguntas? ¡Nos encantaría saber de usted!"

#. js-lingui-explicit-id
msgid "Contact us: {CONTACT_EMAIL}"
msgstr "Contáctenos: {CONTACT_EMAIL}"

