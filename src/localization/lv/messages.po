#. js-lingui-explicit-id
msgid "About {NAME_APP}"
msgstr "Par {NAME_APP}"

#. js-lingui-explicit-id
msgid "Your professional beauty companion"
msgstr "Jūsu profesionālais skaistuma pavadonis"

#. js-lingui-explicit-id
msgid "Welcome to {NAME_APP} – your comprehensive mobile solution for beauty professionals! Our app is designed to streamline your business operations, manage client relationships, and boost your productivity."
msgstr "Laipni lūdzam {NAME_APP} – jūsu visaptverošā mobilā risinājumā skaistuma profesionāļiem! Mūsu lietotne ir izstrādāta, lai vienkāršotu jūsu uzņēmuma darbību, pārvaldītu klientu attiecības un palielinātu jūsu produktivitāti."

#. js-lingui-explicit-id
msgid "Key Features"
msgstr "Galvenās funkcijas"

#. js-lingui-explicit-id
msgid "Client Management"
msgstr "Klientu pārvaldība"

#. js-lingui-explicit-id
msgid "Create detailed client profiles, track service history, and maintain comprehensive notes for each appointment."
msgstr "Izveidojiet detalizētus klientu profilus, izsekojiet pakalpojumu vēsturi un uzturiet pilnīgas piezīmes par katru tikšanos."

#. js-lingui-explicit-id
msgid "Smart Calendar"
msgstr "Viedais kalendārs"

#. js-lingui-explicit-id
msgid "Seamless integration with your device calendar. Automatic sync ensures you never miss an appointment."
msgstr "Nepārtraukta integrācija ar jūsu ierīces kalendāru. Automātiskā sinhronizācija nodrošina, ka jūs nekad nepalaidīsi garām tikšanos."

#. js-lingui-explicit-id
msgid "SMS Notifications"
msgstr "SMS paziņojumi"

#. js-lingui-explicit-id
msgid "Send automated SMS reminders to your clients about upcoming appointments and important updates."
msgstr "Sūtiet automatizētus SMS atgādinājumus saviem klientiem par gaidāmajām tikšanās un svarīgiem atjauninājumiem."

#. js-lingui-explicit-id
msgid "Speech-to-Text"
msgstr "Runas-teksts"

#. js-lingui-explicit-id
msgid "Convert your voice notes into text for quick and easy appointment documentation and client notes."
msgstr "Pārveidojiet savas balss piezīmes tekstā ātrai un vieglai tikšanos dokumentācijai un klientu piezīmēm."

#. js-lingui-explicit-id
msgid "Photo Gallery"
msgstr "Foto galerija"

#. js-lingui-explicit-id
msgid "Store and organize photos from each appointment to track client progress and showcase your work."
msgstr "Glabājiet un organizējiet fotogrāfijas no katras tikšanās, lai izsekotu klientu progresu un parādītu savu darbu."

#. js-lingui-explicit-id
msgid "Multi-Platform Sync"
msgstr "Vairāku platformu sinhronizācija"

#. js-lingui-explicit-id
msgid "Access your data seamlessly across mobile app and web platform with real-time synchronization."
msgstr "Piekļūstiet saviem datiem bez pārtraukuma mobilajā lietotnē un tīmekļa platformā ar reāllaika sinhronizāciju."

